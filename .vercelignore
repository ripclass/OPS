.env.*
**/.env
**/.env.local
backend/
log/
static/
node_modules/
tmp-ui-flow/
tmp-live-bundle.js
.pytest_cache/
.github/
.claude/
.git/
Dockerfile
docker-compose.yml
render.yaml
*.pdf
*.docx
frontend/vite-dev.log
frontend/node_modules/
